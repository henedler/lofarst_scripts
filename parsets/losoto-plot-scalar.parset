axesInPlot = [freq]
axisInTable = ant
prefix = plots/amp-

[plotP2]
operation = PLOT
soltab = sol000/phase000
axesInPlot = [freq]
axisInTable = ant
prefix = plots/ph-
refAnt = auto
minmax = [-3.14,3.14]


